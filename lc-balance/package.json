{
  "name": "lc-balance-wc",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "generate:calendar": "node scripts/generate-domestic-calendar.mjs",
    "pretest": "npm run generate:calendar",
    "prebuild": "npm run generate:calendar",
    "ng": "ng",
    "start": "ng serve --open",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "lint": "eslint src",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "dev:all": "concurrently -n microservice,backend,angular -c blue,green,magenta \"npm run dev --prefix microservices/balance-component\" \"npm start --prefix backend\" \"ng serve\""
  },
  "dependencies": {
    "@angular/animations": "^18.2.14",
    "@angular/common": "^18.2.14",
    "@angular/compiler": "^18.2.14",
    "@angular/core": "^18.2.14",
    "@angular/forms": "^18.2.14",
    "@angular/platform-browser": "^18.2.14",
    "@angular/platform-browser-dynamic": "^18.2.14",
    "@angular/router": "^18.2.14",
    "@ngx-formly/bootstrap": "^6.3.12",
    "@ngx-formly/core": "^6.3.12",
    "bootstrap": "^5.3.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.6.0",
    "zone.js": "~0.14.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^18.2.21",
    "@angular/cli": "^18.2.21",
    "@angular/compiler-cli": "^18.2.14",
    "@eslint/js": "^9.39.5",
    "@types/jest": "^29.5.14",
    "angular-eslint": "^18.4.3",
    "concurrently": "^10.0.4",
    "eslint": "^9.39.5",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jest-preset-angular": "^14.6.2",
    "prettier": "^3.9.6",
    "typescript": "~5.4.0",
    "typescript-eslint": "^8.67.0"
  }
}
