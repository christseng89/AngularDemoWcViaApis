{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:lc-ssi:ssi-mt1-mt2:rule-oracle:v1",
  "title": "SSI MT1/MT2 No-Inference Rule and Oracle Contract",
