    "sourceEvidence": {
      "type":"object",
      "additionalProperties":false,
      "required":["sourceArtifactId","sourceRelease","sourceVersion","sourceFilename","sourceSha256","ruleId","sectionOrPage","ruleCategory","registryId"],
      "properties":{
