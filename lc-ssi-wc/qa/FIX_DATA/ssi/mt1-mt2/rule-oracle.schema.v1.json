        "ruleId":{"$ref":"#/$defs/nonEmptyId"},
        "sectionOrPage":{"type":"string","minLength":1},
        "ruleCategory":{"enum":["NORMATIVE","BA_RULING","QA_INVARIANT","PRODUCT_POLICY"]},
        "registryId":{"enum":["CONTROLLED_SOURCE_REGISTER","BA_RULING_REGISTRY","QA_INVARIANT_REGISTRY","PRODUCT_POLICY_REGISTRY"]}
      },
      "allOf":[
        {"if":{"properties":{"ruleCategory":{"const":"NORMATIVE"}}},"then":{"properties":{"registryId":{"const":"CONTROLLED_SOURCE_REGISTER"}}}},
        {"if":{"properties":{"ruleCategory":{"const":"BA_RULING"}}},"then":{"properties":{"registryId":{"const":"BA_RULING_REGISTRY"}}}},
        {"if":{"properties":{"ruleCategory":{"const":"QA_INVARIANT"}}},"then":{"properties":{"registryId":{"const":"QA_INVARIANT_REGISTRY"}}}},
