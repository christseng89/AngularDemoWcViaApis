{
  "openapi": "3.1.0",
  "info": {
    "title": "Baseline SWIFT Data Service",
    "version": "1.1.0-prototype",
    "description": "SR2026 prototype contract. BIC syntax follows ISO 9362; currency codes are supplied by the ISO 4217 Currency service. Licensed SwiftRef/RMA/SSI data remains a production prerequisite."
  },
  "servers": [
    {
      "url": "http://localhost:3100/api"
    }
  ],
  "x-standards-baseline": {
    "standardsRelease": "SR2026",
    "bicStandard": "ISO 9362",
    "currencyStandard": "ISO 4217",
    "dataClassification": "SYNTHETIC_DEMO"
  },
  "x-ui-resources": [
    {
      "id": "rma",
      "label": "RMA Authorisation",
      "endpoint": "rma-authorisations",
      "importType": "RMA",
      "description": "\u7ba1\u7406 BIC \u5c0d\u3001FIN/FINPLUS\u3001\u65b9\u5411\u8207\u8a0a\u606f\u7bc4\u570d\uff1bRMA \u53ea\u4ee3\u8868\u901a\u8a0a\u6388\u6b0a\uff0c\u4e0d\u8b49\u660e SSI \u6216\u5e33\u6236\u6240\u6709\u6b0a\u3002",
      "columns": [
        {
          "path": "ownBic",
          "label": "Own BIC"
        },
        {
          "path": "counterpartyBic",
          "label": "Counterparty BIC"
        },
        {
          "path": "service",
          "label": "Service"
        },
        {
          "path": "direction",
          "label": "Direction"
        },
        {
          "path": "messageTypes",
          "label": "Messages"
        },
        {
          "path": "status",
          "label": "Status"
        },
        {
          "path": "version",
          "label": "Version"
        }
      ],
      "fields": [
        {
          "key": "maker",
          "label": "Maker",
          "required": true,
          "type": "input",
          "defaultValue": "maker.demo"
        },
        {
          "key": "ownBic",
          "label": "Own BIC (ISO 9362)",
          "required": true,
          "type": "input",
          "pattern": "^[A-Z0-9]{4}[A-Z]{2}[A-Z0-9]{2}([A-Z0-9]{3})?$",
          "minLength": 8,
          "maxLength": 11
        },
        {
          "key": "counterpartyBic",
          "label": "Counterparty BIC (ISO 9362)",
          "required": true,
          "type": "input",
          "pattern": "^[A-Z0-9]{4}[A-Z]{2}[A-Z0-9]{2}([A-Z0-9]{3})?$",
          "minLength": 8,
          "maxLength": 11
        },
        {
          "key": "service",
          "label": "SWIFT Service",
          "required": true,
          "type": "select",
          "options": ["FIN", "FINPLUS"],
          "defaultValue": "FIN"
        },
        {
          "key": "direction",
          "label": "Direction",
          "required": true,
          "type": "select",
          "options": ["INBOUND", "OUTBOUND"],
          "defaultValue": "OUTBOUND"
        },
        {
          "key": "messageTypes",
          "label": "Message Types",
          "required": true,
          "type": "multicheckbox",
          "options": [
            "MT300",
            "MT320",
            "MT400",
            "MT700",
            "MT740",
            "MT742",
            "MT760",
            "MT765",
            "pacs.008.001.12",
            "pacs.009.001.12",
            "pacs.009.001.12.COV"
          ]
        },
        {
          "key": "validFrom",
          "label": "Valid From",
          "required": true,
          "type": "input",
          "inputType": "date",
          "defaultValue": "2026-01-01"
        },
        {
          "key": "validTo",
          "label": "Valid To",
          "required": true,
          "type": "input",
          "inputType": "date",
          "defaultValue": "2027-12-31"
        }
      ],
      "x-lifecycle": ["submit", "approve", "activate", "revise", "revoke"]
    },
    {
      "id": "ssi",
      "label": "SSI",
      "endpoint": "ssis",
      "importType": "SSI",
      "description": "\u7ba1\u7406\u53ef\u91cd\u7528\u6216\u55ae\u7b46\u4ea4\u6613\u7684 Settlement Instruction\uff1bActual SWIFT Receiver BIC \u5728\u4f7f\u7528\u6642\u5fc5\u9808\u901a\u904e\u5c0d\u61c9\u7684 RMA authorization\u3002",
