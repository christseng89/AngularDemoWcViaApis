          "path": "route.settlementMarket",
          "label": "Settlement Market"
        },
        {
          "path": "route.clearingSystem",
          "label": "Clearing System"
        },
        {
          "path": "route.schemeType",
          "label": "Scheme Type"
        },
        {
          "path": "route.routePreference",
          "label": "Route Class"
        },
        {
          "path": "route.priority",
          "label": "Priority"
        },
        {
          "path": "route.validFrom",
          "label": "Effective From"
        },
        {
          "path": "route.validTo",
          "label": "Effective To"
        },
        {
          "path": "scope",
          "label": "Scope"
        },
        {
          "path": "status",
          "label": "Status"
        },
        {
          "path": "version",
          "label": "Version"
        }
      ],
      "fields": [
        {
          "key": "maker",
          "label": "Maker",
          "required": true,
          "type": "input",
          "defaultValue": "maker.demo"
        },
        {
          "key": "route.ssiCode",
          "label": "SSI ID / Stable Code",
          "required": true,
          "type": "input"
        },
        {
          "key": "route.ssiName",
          "label": "SSI Name",
          "required": true,
          "type": "input"
        },
        {
          "key": "counterpartyId",
          "label": "Counterparty Master ID",
          "required": true,
          "type": "input"
        },
        {
          "key": "route.counterpartyName",
          "label": "Counterparty Name",
          "required": true,
          "type": "input"
        },
        {
          "key": "route.counterpartyBic",
          "label": "Counterparty BIC Matcher",
          "required": true,
          "type": "input"
        },
        {
          "key": "route.counterpartyCountry",
          "label": "Counterparty Country Matcher",
          "required": true,
          "type": "input",
          "maxLength": 3
        },
        {
          "key": "route.applicabilityProfileId",
          "label": "Applicability Profile ID",
          "required": true,
          "type": "input"
