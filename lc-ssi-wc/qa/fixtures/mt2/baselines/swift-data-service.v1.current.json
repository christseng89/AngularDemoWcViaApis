        {
          "key": "scope",
          "label": "SSI Scope",
          "description": "STANDING = reusable standing instruction; TRANSACTION_SPECIFIC requires a transaction binding before activation.",
          "required": true,
          "type": "select",
          "options": ["STANDING", "TRANSACTION_SPECIFIC"],
          "defaultValue": "STANDING"
        },
        {
          "key": "route.currency",
          "label": "Currency (ISO 4217)",
          "required": true,
          "type": "select",
          "optionsSource": "reference/currencies"
        },
        {
          "key": "route.bookingEntity",
          "label": "Booking Entity",
          "required": true,
          "type": "input"
        },
        {
          "key": "route.settlementCountry",
          "label": "Settlement / Clearing Country",
          "required": true,
          "type": "input",
          "maxLength": 3
        },
        {
          "key": "route.settlementMarket",
          "label": "Settlement Market",
          "required": true,
          "type": "input"
        },
        {
          "key": "route.clearingSystem",
          "label": "Related RTGS / Clearing System",
          "description": "Must reference one concrete active Clearing System Standing Data code; TARGET/TARGET2 are legacy aliases and new SSI must use T2.",
          "required": true,
          "type": "input"
        },
        {
          "key": "route.schemeType",
          "label": "Scheme Type",
          "description": "RTGS, LVPS, ACH or IPS; non-RTGS rails must not be labelled RTGS.",
          "required": true,
          "type": "select",
          "options": ["RTGS", "LVPS", "ACH", "IPS"]
        },
        {
          "key": "route.routeType",
          "label": "Route Type",
          "required": true,
          "type": "select",
          "options": [
            "DIRECT",
            "CORRESPONDENT",
            "INTERMEDIARY",
            "COVER",
            "CLEARING_AGENT"
          ]
        },
        {
          "key": "route.routePreference",
          "label": "Route Class",
          "description": "PRIMARY, SECONDARY or approved FALLBACK.",
          "required": true,
          "type": "select",
          "options": ["PRIMARY", "SECONDARY", "FALLBACK"]
        },
        {
          "key": "route.priority",
          "label": "Priority",
          "description": "Lower numeric value has higher precedence within the same specificity and Route Class.",
          "required": true,
          "type": "input",
          "inputType": "number",
          "minimum": 1,
          "maximum": 999
        },
        {
          "key": "route.accountWithBic",
          "label": "Account With Institution (ISO 9362)",
          "required": true,
          "type": "input",
          "pattern": "^[A-Z0-9]{4}[A-Z]{2}[A-Z0-9]{2}([A-Z0-9]{3})?$",
          "minLength": 8,
          "maxLength": 11
        },
        {
          "key": "route.actualReceiverBic",
          "label": "Actual SWIFT Receiver BIC",
          "required": true,
          "type": "input",
          "pattern": "^[A-Z0-9]{4}[A-Z]{2}[A-Z0-9]{2}([A-Z0-9]{3})?$",
          "minLength": 8,
          "maxLength": 11
        },
        {
          "key": "route.accountServicerCountry",
          "label": "Account Servicer Country",
          "required": true,
          "type": "input",
          "maxLength": 2
        },
        {
          "key": "route.correspondentCountry",
          "label": "Correspondent Country",
          "required": true,
          "type": "input",
          "maxLength": 2
        },
        {
          "key": "route.beneficiaryBic",
          "label": "Beneficiary BIC (ISO 9362)",
          "required": true,
          "type": "input",
          "pattern": "^[A-Z0-9]{4}[A-Z]{2}[A-Z0-9]{2}([A-Z0-9]{3})?$",
          "minLength": 8,
          "maxLength": 11
        },
        {
          "key": "route.beneficiaryBankCountry",
          "label": "Beneficiary Bank Country",
          "required": true,
          "type": "input",
          "maxLength": 3
        },
        {
          "key": "route.intermediaryBic",
          "label": "Intermediary Institution (ISO 9362)",
          "type": "input",
          "pattern": "^[A-Z0-9]{4}[A-Z]{2}[A-Z0-9]{2}([A-Z0-9]{3})?$",
          "maxLength": 11
        },
        {
          "key": "route.accountId",
          "label": "Account / Nostro ID",
          "required": true,
          "type": "input"
        },
        {
          "key": "route.resolutionReason",
          "label": "Approved Route Rationale",
          "required": true,
          "type": "input"
        },
        {
          "key": "route.validFrom",
          "label": "Valid From",
          "required": true,
