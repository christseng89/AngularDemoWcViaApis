  "paths": {
    "/rma-authorisations": {
      "get": {
        "operationId": "listRma",
        "responses": {
          "200": {
            "description": "RMA records"
          }
        }
      },
      "post": {
        "operationId": "createRmaDraft",
        "requestBody": {
          "$ref": "#/components/requestBodies/Rma"
        },
        "responses": {
          "201": {
            "description": "DRAFT created"
          },
          "400": {
            "$ref": "#/components/responses/ValidationError"
          }
        }
      }
    },
    "/rma-authorisations/{id}": {
      "put": {
        "operationId": "updateRmaDraft",
        "parameters": [
          {
            "$ref": "#/components/parameters/Id"
          }
        ],
        "requestBody": {
          "$ref": "#/components/requestBodies/Rma"
        },
        "responses": {
          "200": {
            "description": "DRAFT updated"
          }
        }
      },
      "delete": {
        "operationId": "revokeRma",
        "parameters": [
          {
            "$ref": "#/components/parameters/Id"
          }
        ],
        "responses": {
          "200": {
            "description": "Logically revoked; audit retained"
          }
        }
      }
    },
    "/rma-authorisations/check": {
      "post": {
        "operationId": "checkRma",
        "responses": {
          "200": {
            "description": "AUTHORISED, NOT_AUTHORISED, NOT_FOUND or AMBIGUOUS"
