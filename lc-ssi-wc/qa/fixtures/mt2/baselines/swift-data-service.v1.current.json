        {
          "path": "route.currency",
          "label": "Currency"
        },
        {
          "path": "route.counterpartyBic",
          "label": "Counterparty BIC"
        },
        {
          "path": "route.counterpartyCountry",
          "label": "Counterparty Country"
        },
        {
          "path": "route.accountWithBic",
          "label": "Account With"
        },
        {
          "path": "route.settlementCountry",
          "label": "Settlement Country"
