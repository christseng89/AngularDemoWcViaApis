    "/swift-data/imports": {
      "post": {
        "operationId": "importSwiftData",
        "responses": {
          "200": {
            "description": "Row-level validation/import result; accepted records remain DRAFT"
          }
        }
      }
    },
    "/reference/fin-tag-suggestions": {
      "post": {
        "operationId": "suggestReferenceFin5xTags",
        "description": "Deprecated compatibility adapter. Use POST /reference/fin-tag-resolutions. It maps resolvedFields to the legacy suggestions shape and never supports payment execution.",
        "responses": {
          "200": {
            "description": "Non-payment MT 5x suggestions; paymentExecutable is always false."
          },
          "400": {
            "description": "FIN context incomplete or no verified exact mapping."
          }
        },
        "deprecated": true
      }
    },
    "/settlements/resolve": {
      "post": {
        "operationId": "previewExecutableSettlement",
        "description": "Pre-settlement PAYMENT_SSI preview for an OUTGOING executable MT2 payment. The server derives counterpartyType=BANK from the selectable SR2026 Payment Message Index profile and rejects a client-supplied counterpartyType. MT/MX output format is deliberately absent because it is not a matching or ranking key.",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Mt2BankResolutionRequest" } } }
        },
        "responses": {
          "200": {
            "description": "Ranked preview; paymentExecutable remains false until confirm.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Mt2ResolutionResponse" } } }
          },
          "400": {
            "description": "Incomplete or non-payment/incoming context, unsupported Message Index profile, target mismatch, or client-supplied counterpartyType."
          }
        }
      }
    },
    "/settlements/{resolutionId}/confirm": {
      "post": {
        "operationId": "confirmExecutableSettlement",
        "parameters": [
          {
            "name": "resolutionId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "description": "Rechecks eligibility, Actual Receiver RMA and matching Nostro, then returns canonical roles plus immutable snapshot/token/hash. The caller owns full message assembly, transaction lifecycle and accounting.",
        "responses": {
          "200": {
            "description": "Confirmed PAYMENT_SSI; paymentExecutable true."
          },
          "409": {
            "description": "Preview stale or route no longer eligible."
          }
        }
      }
    },
    "/settlements/clearing-options": {
      "post": {
        "operationId": "listEligibleResolutionClearingOptions",
        "description": "Returns only clearing systems referenced by currently Active and eligible SSI routes for the submitted MT2 payment-trigger transaction criteria, intersected with active Clearing System Standing Data. The selectable sourceMessageType is required; counterpartyType=BANK is server-derived and must not be supplied by the client. This is not the full capability catalogue.",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Mt2BankResolutionRequest" } } }
        },
        "responses": {
          "200": {
            "description": "Eligible SSI-backed clearing override options.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Mt2ResolutionResponse" } } }
          }
        }
      }
    },
    "/own-account-settlements/resolve": {
      "post": {
        "operationId": "resolveOwnAccountSettlement",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/OwnAccountSettlementRequest" } } } },
        "responses": { "200": { "description": "MRG-governed own-account result.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Mt2ResolutionResponse" } } } } }
      }
    },
    "/fi-direct-debits/resolve": {
      "post": {
        "operationId": "resolveFiDirectDebit",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/FiDirectDebitRequest" } } } },
        "responses": { "200": { "description": "MRG-governed FI direct-debit result.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Mt2ResolutionResponse" } } } } }
      }
    },
    "/payment-notifications/resolve": {
      "post": {
        "operationId": "resolvePaymentNotification",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PaymentNotificationRequest" } } } },
        "responses": { "200": { "description": "MRG-governed payment-notification result.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Mt2ResolutionResponse" } } } } }
      }
    },
    "/reference/clearing-systems": {
      "get": {
        "operationId": "listClearingSystems",
        "parameters": [
          {
            "name": "currency",
            "in": "query",
            "required": false,
            "schema": {
              "$ref": "#/components/schemas/Currency"
            }
          },
          {
            "name": "settlementCountry",
            "in": "query",
            "required": false,
            "description": "ISO 3166-1 alpha-2 market hint. Includes exact-market rails and governed PAN_REGIONAL rails whose eligibleCountries contain the requested country.",
            "schema": {
              "type": "string",
              "pattern": "^[A-Z]{2}$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Active governed clearing-system standing data; TARGET/TARGET2 are legacy aliases for T2.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ClearingSystemPage"
                }
              }
            }
          }
        }
      }
    },
    "/reference/fin-resolution-catalogue": {
      "get": {
        "operationId": "listFinResolutionCatalogue",
        "description": "Returns the SR-governed outward MT3/MT4/MT7 catalogue with an explicit message-level SSI resolution scope marker and SSI-resolvable tag options.",
        "parameters": [
          {
            "name": "standardsRelease",
            "in": "query",
            "schema": { "type": "string", "default": "SR2026" }
          }
        ],
        "responses": {
          "200": {
            "description": "Parameter-driven FIN Resolution catalogue; each message is marked SSI_RESOLVABLE or NO_SSI_RESOLVABLE_FIELDS."
          }
        }
      }
    },
    "/reference/fin-tag-resolutions": {
      "post": {
        "operationId": "resolveReferenceFin5xFields",
        "description": "Primary SR2026-governed, reference-only FIN field resolution for Treasury MT3 and Trade Finance MT4/MT7. No payment execution or confirmation semantics.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "service",
                  "resolutionMode",
                  "standardsRelease",
                  "messageType",
                  "direction",
                  "businessFunction",
                  "transactionReference",
                  "currency",
                  "receiverBic",
                  "valueDate",
                  "roles"
                ],
                "properties": {
                  "service": {
                    "const": "FIN"
                  },
                  "resolutionMode": {
                    "enum": ["TREASURY", "TRADE_FINANCE"]
                  },
                  "standardsRelease": {
                    "const": "SR2026"
                  },
                  "messageType": {
                    "type": "string",
                    "pattern": "^MT[0-9]{3}$"
                  },
                  "direction": {
                    "const": "OUTGOING"
                  },
                  "businessFunction": {
                    "type": "string"
                  },
                  "sequence": {
                    "type": "string"
                  },
                  "settlementLeg": {
                    "type": "string"
                  },
                  "fieldOptions": {
                    "type": "object",
                    "additionalProperties": {
                      "type": "string"
                    }
                  },
                  "transactionReference": {
                    "type": "string"
                  },
                  "currency": {
                    "type": "string",
                    "pattern": "^[A-Z]{3}$"
                  },
                  "receiverBic": {
                    "type": "string"
                  },
                  "bookingEntity": {
                    "type": "string"
                  },
                  "valueDate": {
                    "type": "string",
                    "format": "date"
                  },
                  "roles": {
                    "type": "object",
                    "additionalProperties": {
                      "type": "string"
                    }
                  },
                  "roleEvidence": {
                    "type": "object",
                    "description": "Evidence and canonical settlement-route node identity for each role. Equal BICs are normalized only when canonicalRouteNodeId and ownerSide also match.",
                    "additionalProperties": {
                      "type": "object",
                      "properties": {
                        "ownerSide": {
                          "enum": [
                            "SENDER_SIDE",
                            "RECEIVER_SIDE",
                            "TRANSACTION_PARTY"
                          ]
                        },
                        "sourceType": { "type": "string" },
                        "sourceRecordId": { "type": "string" },
                        "version": { "type": "string" },
                        "status": { "type": "string" },
                        "approvalStatus": { "type": "string" },
                        "effectiveFrom": { "type": "string", "format": "date" },
                        "effectiveTo": { "type": "string", "format": "date" },
                        "canonicalRouteNodeId": {
                          "type": "string",
                          "description": "Identity derived from normalized BIC11, branch, account owner/servicer/identifier, currency, clearing context and instruction provenance; a BIC alone is insufficient."
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Reference-only resolvedFields result; paymentExecutable is always false.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "usage",
                    "paymentExecutable",
                    "confirmationSupported",
                    "resolvedFields"
                  ],
                  "properties": {
                    "usage": {
                      "const": "REFERENCE_ONLY"
                    },
                    "paymentExecutable": {
                      "const": false
                    },
                    "confirmationSupported": {
                      "const": false
                    },
                    "resolvedFields": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": [
                          "standardsRelease",
                          "messageType",
                          "sequence",
                          "settlementLeg",
                          "tag",
                          "option",
                          "officialFieldName",
                          "officialRole",
                          "businessFunction",
                          "scopeStatus",
                          "resolutionStatus",
                          "reasonCode",
                          "resolvedValue",
                          "nvrRefs",
                          "provenance"
                        ],
                        "properties": {
                          "standardsRelease": {
                            "type": "string"
                          },
                          "messageType": {
                            "type": "string"
                          },
                          "sequence": {
                            "type": "string"
                          },
                          "settlementLeg": {
                            "type": "string"
                          },
                          "tag": {
                            "type": "string"
                          },
                          "option": {
                            "type": "string"
                          },
                          "officialFieldName": {
                            "type": "string"
                          },
                          "officialRole": {
                            "type": "string"
                          },
                          "businessFunction": {
                            "type": "string"
                          },
                          "scopeStatus": {
                            "enum": ["SSI_SUPPORTED", "OUT_OF_SSI_SCOPE"]
                          },
                          "resolutionStatus": {
                            "description": "Runtime disposition for every audited field slot. Profile-excluded slots are returned explicitly as N_A rather than omitted.",
                            "enum": [
                              "RESOLVED",
                              "NOT_REQUIRED",
                              "NO_ELIGIBLE_SSI",
                              "N_A"
                            ]
                          },
                          "reasonCode": {
                            "description": "Controlled reason such as ROUTE_COMPLETE or MESSAGE_PROFILE_EXCLUDED. A ROUTE_COMPLETE decision is attributed to ROUTE_RESOLVER/CANONICAL_ROUTE in provenance.",
                            "type": "string"
                          },
                          "resolvedValue": {
                            "type": ["string", "null"]
                          },
                          "nvrRefs": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            }
                          },
                          "provenance": {
                            "description": "For NOT_REQUIRED route decisions, source is ROUTE_RESOLVER and ownerSide is CANONICAL_ROUTE; original candidate source/owner are retained separately when applicable.",
                            "type": "object"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Context, exact profile, option, or eligible SSI evidence is invalid/missing."
          }
        }
      }
    }
  },
  "components": {
    "parameters": {
      "Id": {
        "name": "id",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      }
    },
    "requestBodies": {
      "Rma": {
        "required": true,
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/RmaCommand"
            }
          }
        }
      },
      "Ssi": {
        "required": true,
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/SsiCommand"
            }
          }
        }
      },
      "Nostro": {
        "required": true,
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/NostroCommand"
            }
          }
        }
      }
    },
    "responses": {
      "ValidationError": {
        "description": "SWIFT/ISO syntax or business-rule validation failed"
      }
    },
    "schemas": {
      "Bic": {
        "type": "string",
        "pattern": "^[A-Z0-9]{4}[A-Z]{2}[A-Z0-9]{2}([A-Z0-9]{3})?$",
        "minLength": 8,
        "maxLength": 11,
        "description": "ISO 9362 BIC syntax only; directory existence requires licensed Bank/SwiftRef data."
      },
      "Currency": {
        "type": "string",
        "pattern": "^[A-Z]{3}$",
        "description": "Must also exist in Currency service ISO 4217 data."
      },
      "ClearingSystemReference": {
        "type": "object",
        "required": [
          "code",
          "name",
          "supportedCurrency",
          "settlementCountry",
          "marketScope",
          "eligibleCountries",
          "settlementMarket",
          "paymentServiceLevel",
          "schemeType",
          "status",
          "validFrom",
          "validTo"
        ],
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "supportedCurrency": {
            "$ref": "#/components/schemas/Currency"
          },
          "settlementCountry": {
            "type": "string",
            "pattern": "^([A-Z]{2}|ANY)$"
          },
          "marketScope": {
            "enum": ["DOMESTIC", "MARKET_SPECIFIC", "PAN_REGIONAL"]
          },
          "eligibleCountries": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[A-Z]{2}$"
            }
          },
          "settlementMarket": {
            "type": "string",
            "minLength": 1
          },
          "paymentServiceLevel": {
            "enum": ["HIGH_VALUE", "RETAIL", "INSTANT"]
          },
          "schemeType": {
            "enum": ["RTGS", "LVPS", "ACH", "IPS"]
          },
          "status": {
            "enum": ["ACTIVE", "INACTIVE"]
          },
          "validFrom": {
            "type": "string",
            "format": "date"
          },
          "validTo": {
            "type": "string",
            "format": "date"
          },
          "legacyAliases": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Accepted only for migration/reference; current UI displays the canonical code."
          }
        }
      },
      "ClearingSystemPage": {
        "type": "object",
        "required": ["items", "source", "aliasPolicy", "disclaimer"],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ClearingSystemReference"
            }
          },
          "source": {
            "type": "string"
          },
          "aliasPolicy": {
            "type": "string"
          },
          "disclaimer": {
            "type": "string"
          }
        }
      },
      "SwiftMessageType": {
        "type": "string",
        "pattern": "^(MT[0-9]{3}(COV)?|pacs\\.[A-Za-z0-9.]+|\\*)$"
      },
      "RmaCommand": {
        "type": "object",
        "required": [
          "ownBic",
          "counterpartyBic",
          "service",
          "direction",
          "messageTypes",
          "validFrom",
          "validTo",
          "maker"
        ],
        "properties": {
          "ownBic": {
            "$ref": "#/components/schemas/Bic"
          },
          "counterpartyBic": {
            "$ref": "#/components/schemas/Bic"
          },
          "service": {
            "enum": ["FIN", "FINPLUS"]
          },
          "direction": {
            "enum": ["INBOUND", "OUTBOUND"]
          },
          "messageTypes": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "$ref": "#/components/schemas/SwiftMessageType"
            }
          },
          "validFrom": {
            "type": "string",
            "format": "date"
          },
          "validTo": {
            "type": "string",
            "format": "date"
          },
          "maker": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "SsiCommand": {
        "type": "object",
        "required": ["counterpartyId", "scope", "route", "maker"],
        "properties": {
          "counterpartyId": {
            "type": "string",
            "minLength": 1
          },
          "scope": {
            "enum": ["STANDING", "TRANSACTION_SPECIFIC"]
          },
          "route": {
            "type": "object",
            "required": [
              "currency",
              "beneficiaryBic",
              "accountWithBic",
              "settlementCountry",
              "settlementMarket",
              "clearingSystem",
              "schemeType"
            ],
            "properties": {
              "currency": {
                "$ref": "#/components/schemas/Currency"
              },
              "beneficiaryBic": {
                "$ref": "#/components/schemas/Bic"
              },
              "accountWithBic": {
                "$ref": "#/components/schemas/Bic"
              },
              "intermediaryBic": {
                "$ref": "#/components/schemas/Bic"
              },
              "accountId": {
                "type": "string"
              },
              "settlementCountry": {
                "type": "string",
                "pattern": "^[A-Z]{2}$",
                "description": "ISO 3166-1 alpha-2 settlement-market country; distinct from counterparty/correspondent country."
              },
              "settlementMarket": {
                "type": "string",
                "minLength": 1
              },
              "clearingSystem": {
                "type": "string",
                "minLength": 1,
                "not": {
                  "enum": ["ANY"]
                },
                "description": "Concrete active standing-data code for the related RTGS or clearing scheme."
              },
              "schemeType": {
                "enum": ["RTGS", "LVPS", "ACH", "IPS"],
                "description": "Governed classification: RTGS, other large-value payment system, ACH, or instant payment scheme."
              }
            }
          },
          "maker": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "Mt2ResolutionResponse": {
        "type": "object",
        "required": ["redirectDomain"],
        "properties": { "redirectDomain": { "type": ["string", "null"], "description": "Owning MT2 resolution domain when the caller must redirect; null on a terminal decision." } }
      },
      "Mt2BankResolutionRequest": {
        "type": "object",
        "required": ["counterpartyBankServiceId"],
        "properties": {
          "counterpartyBankServiceId": { "$ref": "#/components/schemas/BankServiceId" },
          "sourceMessageType": { "type": "string" },
          "messageType": { "type": "string" }
        },
        "description": "The service resolves the read-only BIC from the Bank Service identity; callers must not submit a BIC."
      },
      "OwnAccountSettlementRequest": {
        "type": "object",
        "properties": {
          "receiverBankServiceId": { "$ref": "#/components/schemas/BankServiceId" },
          "accountWithBankServiceId": { "$ref": "#/components/schemas/BankServiceId" },
          "intermediaryBankServiceId": { "$ref": "#/components/schemas/BankServiceId" }
        }
      },
      "FiDirectDebitRequest": {
        "type": "object",
        "properties": { "debitInstitutionBankServiceId": { "$ref": "#/components/schemas/BankServiceId" } }
      },
      "PaymentNotificationRequest": {
        "type": "object",
        "properties": { "orderingInstitutionBankServiceId": { "$ref": "#/components/schemas/BankServiceId" } }
      },
      "BankServiceId": {
        "type": "string",
        "pattern": "^BANK-SVC-[A-Z0-9]{8,11}$",
        "description": "Stable Bank Service identity. Its BIC is resolved server-side and is read-only output metadata."
      },
      "NostroCommand": {
        "type": "object",
        "required": [
          "ownLegalEntityId",
          "accountServicerBic",
          "currency",
          "maskedAccountRef",
          "purpose",
          "priority",
          "validFrom",
          "validTo",
          "maker"
        ],
        "properties": {
          "ownLegalEntityId": {
            "type": "string",
            "minLength": 1
          },
          "accountServicerBic": {
            "$ref": "#/components/schemas/Bic"
          },
          "currency": {
            "$ref": "#/components/schemas/Currency"
          },
          "maskedAccountRef": {
            "type": "string",
            "pattern": "^DEMO-[A-Z0-9-]{4,40}$"
          },
          "purpose": {
            "type": "string",
            "minLength": 1
          },
          "priority": {
            "type": "integer",
            "minimum": 1,
            "maximum": 999
          },
          "validFrom": {
            "type": "string",
            "format": "date"
          },
          "validTo": {
            "type": "string",
            "format": "date"
          },
          "maker": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
