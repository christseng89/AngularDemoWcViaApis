{
  "name": "ssi-wc-prototype",
  "version": "0.1.0",
  "private": true,
  "description": "Parameter-driven SSI prototype demo based on the Gate G0 rc.4 FSD",
  "scripts": {
    "dev:all": "nx run-many -t serve --projects=ssi-service,ssi-bff,mock-reference-services,ssi-portal,ssi-web-components --parallel=5 --outputStyle=stream",
    "start": "npm run dev:all",
    "build": "nx run-many -t build",
    "lint": "eslint apps libs",
    "typecheck": "nx run-many -t typecheck",
    "test": "nx run-many -t test --configuration=ci",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev:stop": "node scripts/free-dev-ports.mjs",
    "predev:all": "npm run dev:stop",
    "demo:seed": "npm run demo:seed:bank-services && node scripts/seed-demo-ssis.mjs && node scripts/seed-swift-data.mjs",
    "demo:seed:export-v153": "python scripts/rebuild-demo-database.py export",
    "demo:rebuild-v153": "python scripts/rebuild-demo-database.py rebuild",
    "demo:seed:bank-services": "node scripts/sync-bank-service-baseline.mjs",
    "demo:seed:swift-data": "node scripts/seed-swift-data.mjs",
    "demo:verify-matrix": "node scripts/verify-supported-routing-matrix.mjs",
    "demo:e2e:clearing": "node scripts/e2e-clearing-ui.mjs",
    "demo:e2e:split": "node scripts/e2e-suggestion-resolution-split.mjs",
    "demo:api-tour": "node scripts/exercise-all-apis.mjs",
    "qa:mt2:final": "node scripts/mt2-final-qa/run.mjs",
    "qa:mt2:final:unit": "node --test --experimental-test-coverage --test-coverage-lines=95.01 scripts/mt2-final-qa/*.test.mjs qa/mt2/test_cases/*.test.mjs",
    "qa:mt2:cases": "node scripts/mt2-final-qa/execute-cases.mjs",
    "qa:mt2:curl": "bash qa/mt2/test_cases/run_mt2_139.sh",
    "qa:mt2:curl:unit": "node --test qa/mt2/test_cases/*.test.mjs",
    "qa:mt2:ui": "node scripts/e2e-mt2-final-ui.mjs",
    "qa:mt2:v151": "node scripts/mt2-v151-uat.mjs",
    "qa:mt2:v153": "node scripts/mt2-v153-uat.mjs",
    "qa:mt2:v153:browser": "node qa/mt2/test_cases/run-v153-browser-uat.mjs",
    "qa:mt2:v153:data-quality": "node qa/mt2/test_cases/run-v153-browser-data-quality.mjs",
    "qa:bank-service:integrity": "node scripts/verify-bank-service-integrity.mjs"
  },
  "dependencies": {
    "@angular/animations": "^22.0.0",
    "@angular/common": "^22.0.0",
    "@angular/compiler": "^22.0.0",
    "@angular/core": "^22.0.0",
    "@angular/elements": "^22.0.0",
    "@angular/forms": "^22.0.0",
    "@angular/platform-browser": "^22.0.0",
    "@angular/platform-browser-dynamic": "^22.0.0",
    "@angular/router": "^22.0.0",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@ngx-formly/core": "^7.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "exceljs": "^4.4.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^22.0.0",
    "@angular-devkit/core": "^22.0.0",
    "@angular-devkit/schematics": "^22.0.0",
    "@angular/build": "^22.0.0",
    "@angular/cli": "^22.0.0",
    "@angular/compiler-cli": "^22.0.0",
    "@eslint/js": "^9.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@nx/angular": "23.2.0",
    "@nx/eslint": "23.2.0",
    "@nx/jest": "23.2.0",
    "@nx/js": "23.2.0",
    "@nx/nest": "23.2.0",
    "@nx/node": "23.2.0",
    "@nx/web": "23.2.0",
    "@nx/workspace": "23.2.0",
    "@playwright/test": "^1.55.0",
    "@swc/core": "^1.16.2",
    "@swc/jest": "^0.2.39",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.0.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.0.0",
    "jest": "^30.0.0",
    "jest-environment-jsdom": "^30.0.0",
    "jest-environment-node": "^30.0.0",
    "nx": "23.2.0",
    "prettier": "^3.6.0",
    "ts-node": "^10.9.2",
    "tslib": "^2.8.1",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.0.0"
  },
  "engines": {
    "node": ">=22.22.3",
    "npm": ">=10"
  },
  "overrides": {
    "multer": "2.3.0",
    "qs": "6.16.0",
    "smol-toml": "1.8.0"
  }
}
