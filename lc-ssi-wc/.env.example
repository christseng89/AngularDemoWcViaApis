NODE_ENV=development
# Authoritative SSI HTTP policy environment. development/demo => controlled
# INCORRECT_SSI_CONFIGURATION is HTTP 409; empty/unknown/other => HTTP 500.
SSI_RUNTIME_ENV=demo
SSI_SERVICE_PORT=3101
SSI_BFF_PORT=3100
MOCK_SERVICES_PORT=3102
SSI_DATABASE_PATH=./data/ssi-demo.sqlite
SSI_DEMO_SEED_PATH=./qa/FIX_DATA/ssi/reload-test-data/ssi-demo.mt347-v1.1.approved.canonical.seed.json
# Sample value for local demo setup only. There is no application fallback.
SSI_DEMO_ADMIN_PASSWORD=123456
# Shared server-governed page size for Payment Message Index and Scenario Index.
# Positive whole number; defaults to 10 when unset and is capped at 100.
SSI_INDEX_PAGE_SIZE=10
# Optional controlled evidence identity. UAT must set this to the verified
# SHA-256 of the exact baseline/overlay snapshot mounted by SSI_DATABASE_PATH.
SSI_EVIDENCE_SNAPSHOT_SHA256=
SSI_SERVICE_URL=http://localhost:3101
MOCK_SERVICES_URL=http://localhost:3102
MOCK_DELAY_MS=0
MOCK_FAILURE_MODE=none
LOG_LEVEL=info
PARAMETER_ROOT=./parameters
SAMPLE_ROOT=./samples
AUDIT_ONLINE_QUERY_DAYS=7
AUDIT_ARCHIVE_AFTER_DAYS=14
AUDIT_ARCHIVE_RETENTION_DAYS=365
AUDIT_RETENTION_SCHEDULE_HOURS=12
API_RETRY_MAX_RETRIES=3
API_RETRY_INITIAL_DELAY_MS=250
API_RETRY_MAX_DELAY_MS=2000
API_RETRY_MAX_ELAPSED_MS=10000
API_REQUEST_TIMEOUT_MS=15000
REVISION_WIP_TTL_MINUTES=5
