{
  "name": "balance-component-service",
  "version": "0.1.0",
  "description": "Balance Component microservice — implements balance-component-api.yaml v0.3.0 and analysis/COMMON-BalanceComponent-Design-zh.md v0.5 (BalanceContract/BalanceMovement ledger, Earmark sufficiency, §6.1 off-balance-sheet WARNING, §6.2 Tolerance conversion).",
  "private": true,
  "type": "commonjs",
  "main": "dist/server.js",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "generate:calendar": "node ../../scripts/generate-domestic-calendar.mjs",
    "pretest": "npm run generate:calendar",
    "prebuild": "npm run generate:calendar",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "dev": "node --watch -r ts-node/register src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "lint": "eslint src test",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\""
  },
  "dependencies": {
    "decimal.js": "^10.4.3",
    "express": "^4.19.2",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.3.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/express": "^4.17.21",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.10.0",
    "@types/supertest": "^7.2.1",
    "eslint": "^9.39.5",
    "jest": "^30.4.2",
    "prettier": "^3.9.6",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.67.0"
  }
}
