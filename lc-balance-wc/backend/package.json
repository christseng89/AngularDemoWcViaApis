{
  "name": "balance-component-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Node.js 中台 orchestrator — runs the declarative Balance Component lifecycle suite and retains A4/A6/B4-ready prerequisites for manual testing.",
  "main": "server.js",
  "scripts": {
    "start": "node --watch server.js",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "lint": "eslint server.js data test",
    "format:check": "prettier --check \"*.js\" \"data/**/*.js\" \"test/**/*.js\""
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "jest": "^29.7.0",
    "prettier": "^3.9.6",
    "supertest": "^6.3.4"
  }
}
