{
  "name": "lc-payment-wc",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "ng": "ng",
    "start": "ng serve --open",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "build:wc": "node scripts/build-wc.mjs",
    "watch:wc": "node scripts/build-wc.mjs --watch",
    "dev:all": "concurrently -n microservice,backend,angular -c blue,green,magenta \"npm run dev --prefix microservices/payment-component\" \"npm start --prefix backend\" \"ng serve\""
  },
  "dependencies": {
    "@angular/animations": "^20.3.32",
    "@angular/common": "^20.3.32",
    "@angular/compiler": "^20.3.32",
    "@angular/core": "^20.3.32",
    "@angular/forms": "^20.3.32",
    "@angular/platform-browser": "^20.3.32",
    "@angular/platform-browser-dynamic": "^20.3.32",
    "@angular/router": "^20.3.32",
    "@ngx-formly/bootstrap": "^6.3.12",
    "@ngx-formly/core": "^6.3.12",
    "bootstrap": "^5.3.0",
    "decimal.js": "^10.6.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.6.0",
    "zone.js": "~0.15.1"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^20.3.37",
    "@angular/cli": "^20.3.37",
    "@angular/compiler-cli": "^20.3.32",
    "@types/jest": "^29.5.14",
    "concurrently": "^10.0.4",
    "esbuild": "^0.20.1",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jest-preset-angular": "^14.6.2",
    "typescript": "~5.8.3"
  }
}
