{
  "name": "payment-component-service",
  "version": "1.10.0",
  "description": "Payment Component microservice — implements POST /payment-instructions per payment-instructions-post.yaml v1.10.0, PaymentComponent-Microservice-FSD-zh.docx, and Payment_Component_Calculation_Validation.docx.",
  "private": true,
  "type": "commonjs",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "dev": "node --watch -r ts-node/register src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "test:regression": "ts-node test/regression.ts"
  },
  "dependencies": {
    "decimal.js": "^10.4.3",
    "express": "^4.19.2",
    "uuid": "^9.0.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.14.9",
    "@types/supertest": "^7.2.1",
    "@types/uuid": "^9.0.8",
    "jest": "^30.4.2",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.3"
  }
}
